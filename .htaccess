# Vanessa Talbot Interior Designs: web server protection (Apache)

Options -Indexes

# Hide dot files such as .env and .git, but allow .well-known for SSL.
RedirectMatch 404 "/\.(?!well-known)"

# Hide folders that are only ever used by PHP on the server.
RedirectMatch 404 "/(database|includes|logs|vendor)(/|$)"

# Composer files list the exact library versions in use.
RedirectMatch 404 "/composer\.(json|lock)$"

# Project documents (README.md, LAUNCH_READINESS.md and others) are for the
# team, not visitors. Blocked in every folder, whatever the capitalisation.
RedirectMatch 404 "(?i)\.md$"

# Never run or serve scripts from the upload folder.
RedirectMatch 404 "(?i)/uploads/.*\.(php[0-9]?|phtml|phar|pl|py|cgi|sh|htaccess)$"

# Original uploads are kept for re-processing, not for the public.
RedirectMatch 404 "/uploads/originals/"

# Search engines and AI assistants: /robots.txt, /sitemap.xml and /llms.txt
# are written by PHP, so they
# always match the published content and the live address (APP_URL).
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^robots\.txt$ robots.php [L]
    RewriteRule ^sitemap\.xml$ sitemap.php [L]
    RewriteRule ^llms\.txt$ llms.php [L]
</IfModule>

# The web app manifest (home-screen icon on phones).
AddType application/manifest+json .webmanifest

# Speed (search engines rank faster pages higher). Text files are sent
# compressed, and browsers keep pictures, styles and scripts so they aren't
# downloaded again on every page. Styles and scripts carry ?v=… with their
# last change, so an update is still picked up straight away. Pages
# themselves are never kept, so edits show at once.
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/xml application/javascript application/json application/manifest+json image/svg+xml
</IfModule>
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 0 seconds"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/vnd.microsoft.icon "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 month"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType application/manifest+json "access plus 1 week"
</IfModule>
