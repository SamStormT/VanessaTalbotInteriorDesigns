# Copy to .env and fill in. Never commit .env.
# On the live server, keep .env in the folder ABOVE the website.

# development shows error details; anything else is treated as production.
APP_ENV=development

# Leave blank at the domain root.
BASE_URL=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=

# Optional: where error logs go (defaults to the logs folder).
#LOG_PATH=

# First-run defaults for Website Settings, used by database/setup.php.
SEED_PHONE=
SEED_EMAIL=

# Later phases
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
PAYFAST_SANDBOX=true
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
