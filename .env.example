# Copy to .env and fill in. Never commit .env.
# On the live server, keep .env in the folder ABOVE the website.

# development shows error details; anything else is treated as production.
APP_ENV=development

# Leave blank at the domain root.
BASE_URL=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=

# Optional: where error logs go (defaults to the logs folder).
#LOG_PATH=

# First-run defaults for Website Settings, used by database/setup.php.
SEED_PHONE=
SEED_EMAIL=

# The site's public address, with https:// and no trailing slash.
# Links in emails (password resets, newsletter confirmation) use it.
# Required in production; locally it falls back to the address in use.
APP_URL=

# Email (PHPMailer). MAIL_MAILER=smtp sends through the mail server.
# MAIL_MAILER=log writes each email to logs/mail/ instead of sending it,
# which is the safe choice on a development machine.
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
# tls (STARTTLS, port 587), ssl (port 465) or none.
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
# Must be a mailbox on the website's own domain, or SPF/DMARC checks fail.
MAIL_FROM_ADDRESS=
#MAIL_FROM_NAME=Vanessa Talbot Interior Designs

# Newsletter campaigns: the most emails the site sends in any hour
# (campaigns and tests together). Set this below your host's limit.
NEWSLETTER_HOURLY_LIMIT=200

# Later phases
PAYFAST_SANDBOX=true
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
